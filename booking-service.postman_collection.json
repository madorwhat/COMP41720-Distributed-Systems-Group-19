{
  "info": {
    "name": "Book My Visa Booking Service & Mock TPV",
    "description": "End-to-end requests for the Booking Service. Run the requests in order with the Collection Runner. The collection creates a fresh user and slot each run; Auth Service must be running for setup, login, and profile updates.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "bookingBaseUrl",
      "value": "http://localhost:4001"
    },
    {
      "key": "authBaseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "adminEmail",
      "value": "admin@example.com"
    },
    {
      "key": "adminPassword",
      "value": "Password123"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "userToken",
      "value": ""
    },
    {
      "key": "userEmail",
      "value": ""
    },
    {
      "key": "userPassword",
      "value": "Password123"
    },
    {
      "key": "bookingId",
      "value": ""
    },
    {
      "key": "slotDay",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Setup and profile",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": "{{bookingBaseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Booking Service is healthy', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{authBaseUrl}}/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin login succeeds', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.collectionVariables.set('adminToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create test user",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('userEmail', `booking-test-${pm.variables.replaceIn('{{$guid}}')}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Test user is created', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.collectionVariables.set('userToken', pm.response.json().accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"fullName\": \"Booking Test User\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{authBaseUrl}}/signup"
          }
        },
        {
          "name": "Update user profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mobile\": \"+353 87 123 4567\",\n  \"nationality\": \"Irish\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{authBaseUrl}}/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('User profile is updated', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().user.nationality).to.eql('Irish');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Mock TPV slots",
      "item": [
        {
          "name": "Seed slot (admin)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const day = new Date();",
                  "day.setUTCDate(day.getUTCDate() + 30);",
                  "pm.collectionVariables.set('slotDay', day.toISOString().slice(0, 10));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin creates a slot', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.collectionVariables.set('bookingId', pm.response.json().slot.bookingId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"country\": \"Schengen\",\n  \"visaType\": \"Student\",\n  \"day\": \"{{slotDay}}\",\n  \"slotTime\": \"09:00 - 10:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{bookingBaseUrl}}/api/v1/tpv/slots"
          }
        },
        {
          "name": "Reject duplicate slot (admin)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"country\": \"Schengen\",\n  \"visaType\": \"Student\",\n  \"day\": \"{{slotDay}}\",\n  \"slotTime\": \"09:00 - 10:00\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{bookingBaseUrl}}/api/v1/tpv/slots"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Duplicate slot is rejected', function () {",
                  "  pm.response.to.have.status(409);",
                  "  pm.expect(pm.response.json().error.code).to.eql('DUPLICATE_SLOT');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List available slots (filtered)",
          "request": {
            "method": "GET",
            "url": "{{bookingBaseUrl}}/api/v1/tpv/slots?country=Schengen&visaType=Student&day={{slotDay}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Filtered slots include the seeded slot', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const slots = pm.response.json().data;",
                  "  pm.expect(slots.some((slot) => slot.bookingId === pm.collectionVariables.get('bookingId'))).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Book the seeded slot",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookingId\": \"{{bookingId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{bookingBaseUrl}}/api/v1/bookings"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Booking succeeds', function () {",
                  "  pm.response.to.have.status(201);",
                  "  pm.expect(pm.response.json().appointment.bookingId).to.eql(pm.collectionVariables.get('bookingId'));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List my booked slots",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{userToken}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{bookingBaseUrl}}/api/v1/bookings/my-slots"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('My booked slots include the appointment', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const appointments = pm.response.json().data;",
                  "  pm.expect(appointments.some((appointment) => appointment.bookingId === pm.collectionVariables.get('bookingId') && appointment.slot.isBooked)).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify booked slot is no longer available",
          "request": {
            "method": "GET",
            "url": "{{bookingBaseUrl}}/api/v1/tpv/slots?country=Schengen&visaType=Student&day={{slotDay}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Booked slot is not listed as available', function () {",
                  "  pm.response.to.have.status(200);",
                  "  const slots = pm.response.json().data;",
                  "  pm.expect(slots.some((slot) => slot.bookingId === pm.collectionVariables.get('bookingId'))).to.eql(false);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
