PORT=4003
DATABASE_URL=postgres://notification:notification@localhost:5435/notification_db
RABBITMQ_URL=amqp://guest:guest@localhost:5672
PREFETCH=10
# The subscription routes check login tokens with Auth's public key (Auth creates it on first start).
JWT_PUBLIC_KEY_PATH=../auth-service/keys/public.pem
CORS_ORIGINS=http://localhost:3000

# Email goes out through Gmail. Both lines are required: the service will not start without them.
# SMTP_USER is the Gmail address that sends the mail. SMTP_PASS is a Gmail App Password: Google
# account > Security > turn on 2-Step Verification > App passwords (https://myaccount.google.com/apppasswords).
# It is NOT your normal password. Remove the spaces Google shows in it.
# Never commit this file with a password in it (.env is git-ignored). `docker compose up` in this
# folder reads the same file.
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-letter-app-password
# Optional. Default: "Book My Visa <SMTP_USER>".
# MAIL_FROM="Book My Visa <you@gmail.com>"

# "New appointments are open" emails. Nobody gets more than one for the same country and visa type
# within this many hours (default 24; 0 = no limit, handy when testing). SITE_URL is put at the end
# of those emails when set.
# SLOT_ALERT_COOLDOWN_HOURS=24
# SITE_URL=http://localhost:3000
