# Settings for all three backend services (Auth, Booking, Notification).
# Copy this file to backend/.env:   cp backend/.env.example backend/.env
# Used both by `docker compose up` (from the repo root) and by `npm run dev` in each service.
# .env is git-ignored: never commit a password.
#
# Ports, database addresses, the RabbitMQ address and Auth's key path are NOT set here. Each
# service has working defaults for running locally, and docker-compose.yml sets the Docker ones:
#
#   Service        Port   Database (when running locally)
#   Auth           4000   postgres://auth:auth@localhost:5432/auth_db
#   Booking        4001   postgres://booking:booking@localhost:5434/booking_db
#   Notification   4003   postgres://notification:notification@localhost:5435/notification_db
#   RabbitMQ       amqp://guest:guest@localhost:5672

# ---------- Shared ----------
# Website address(es) allowed to call the APIs from a browser, separated by commas
CORS_ORIGINS=http://localhost:3000

# ---------- Auth ----------
# How long a login lasts (e.g. 30m, 12h, 1d). There's no refresh token, so users log in again after this.
ACCESS_TOKEN_TTL=1d
# How slow password hashing is on purpose. Higher is safer but slower; 12 is a good default.
BCRYPT_COST=12

# ---------- Notification ----------
# Email goes out through Gmail. Both lines are REQUIRED: Notification will not start without them.
# SMTP_USER is the Gmail address that sends the mail. SMTP_PASS is a Gmail App Password: Google
# account > Security > turn on 2-Step Verification > App passwords (https://myaccount.google.com/apppasswords).
# It is NOT your normal password. Remove the spaces Google shows in it.
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-letter-app-password
# Optional. Default: "Book My Visa <SMTP_USER>".
# MAIL_FROM="Book My Visa <you@gmail.com>"

# "New appointments are open" emails: at most one per person per country and visa type within
# this many hours (0 = no limit, handy when testing).
SLOT_ALERT_COOLDOWN_HOURS=24
# Website address put at the end of those emails
SITE_URL=http://localhost:3000
