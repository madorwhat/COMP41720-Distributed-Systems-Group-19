// Settings for the database scripts (sequelize-cli): where the migration and seed files are, and
// which database to run them on. The database comes from src/config.js, the same one the app uses.
const path = require('path');

module.exports = {
  url: require('./src/config').databaseUrl,
  'migrations-path': path.resolve('db/migrations'),
  'seeders-path': path.resolve('db/seeders'),
};
