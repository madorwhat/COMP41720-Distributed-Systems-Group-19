NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://auth:auth@localhost:5432/auth_db
DB_DIALECT=postgres            # postgres | mysql | sqlite
# DB_STORAGE=dev.sqlite        # only used when DB_DIALECT=sqlite
# DB_SSL=true                  # production only, for hosted Postgres
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
# JWT_PRIVATE_KEY=             # alternatively, PEM content (use \n for newlines); overrides the path
# JWT_PUBLIC_KEY=
JWT_ISSUER=visa-auth-service
JWT_AUDIENCE=visa-platform
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_COST=12
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
INTERNAL_SERVICE_KEY=change-me-long-random-string
NOTIFICATION_SERVICE_URL=      # leave empty if the notification service isn't running
TRUST_PROXY=false              # true only when running behind a reverse proxy / gateway
