# Copy this file to .env and change what you need. Every setting has a default.

# Port the service listens on
PORT=4000

# Connection string for the auth database
DATABASE_URL=postgres://auth:auth@localhost:5432/auth_db

# Frontend address(es) allowed to call the API, separated by commas
CORS_ORIGINS=http://localhost:3000

# How long a login lasts (e.g. 30m, 12h, 1d). There's no refresh token, so users log in again after this.
ACCESS_TOKEN_TTL=1d

# How slow password hashing is on purpose. Higher is safer but slower; 12 is a good default.
BCRYPT_COST=12
