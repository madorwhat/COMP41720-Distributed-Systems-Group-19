              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.expect(pm.response.code).to.be.oneOf([200]));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin/logs?page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "logs"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "page number, starts at 1"
                },
                {
                  "key": "limit",
                  "value": "20",
                  "description": "1 to 100, default 20"
                }
              ]
            },
            "description": "The Logs page: entries newest first, `{ data, page, limit, total }`.\n\nActions: `USER_SIGNUP`, `ADMIN_LOGIN`, `USER_DISABLED`, `USER_ENABLED`, `USER_ROLE_CHANGED`.",
            "auth": {
              "type": "bearer",
              "bearer": [
